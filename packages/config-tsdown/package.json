{
  "name": "@c3-oss/config-tsdown",
  "description": "Shareable tsdown configurations",
  "version": "0.1.0",
  "author": "Caian Ertl <caian@c3.do>",
  "type": "module",
  "types": "./dist/index.d.mts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/sk.js.git"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "concurrently \"tsgo --noEmit\" \"tsdown src/index.ts --format cjs --format esm --dts --clean --deps.skip-node-modules-bundle\"",
    "lint": "biome check .",
    "lint:fix": "biome format --write .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf dist node_modules .turbo",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "bun run bump:dev && bun run bump:prod"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "workspace:^0.3.0",
    "@c3-oss/config-typescript": "workspace:^0.1.0",
    "@typescript/native-preview": "beta",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "tsdown": "^0.22.0"
  }
}
