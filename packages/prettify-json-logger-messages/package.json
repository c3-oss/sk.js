{
  "name": "@c3-oss/prettify-json-logger-messages",
  "description": "Prettify JSON logger messages",
  "version": "1.0.0",
  "author": "Caian Ertl <caian@c3.do>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/sk.js.git"
  },
  "bin": {
    "@c3-oss/prettify-json-logger-messages": "./dist/index.mjs",
    "prettify-json-logger-messages": "./dist/index.mjs"
  },
  "files": ["dist"],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "concurrently \"tsgo --noEmit\" \"tsdown --deps.skip-node-modules-bundle\"",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf coverage dist node_modules .turbo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "bun run bump:dev && bun run bump:prod"
  },
  "dependencies": {
    "json-colorizer": "^3.0.1"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "workspace:^0.3.1",
    "@c3-oss/config-tsdown": "workspace:^0.1.0",
    "@c3-oss/config-typescript": "workspace:^0.1.0",
    "@c3-oss/config-vitest": "workspace:^0.3.0",
    "@typescript/native-preview": "beta",
    "concurrently": "^9.1.2",
    "npm-check-updates": "^17.1.18",
    "tsdown": "^0.22.0"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
