{
  "name": "@c3-oss/aws-wrapper-ecs",
  "description": "Simpler DX for AWS ECS",
  "version": "0.4.2",
  "author": "Caian Ertl <caian@c3.do>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/sk.js.git"
  },
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "concurrently tsc tsup",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf coverage dist node_modules .turbo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "npm run bump:dev && npm run bump:prod"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1101.0",
    "@aws-sdk/client-ecs": "^3.1101.0",
    "@c3-oss/logger": "workspace:^0.1.1",
    "@c3-oss/typeguard": "workspace:^0.2.1",
    "@c3-oss/types": "workspace:^0.1.1",
    "camelize-ts": "^3.0.0",
    "fp-ts": "^2.16.11",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "workspace:^1.0.0",
    "@c3-oss/config-tsup": "workspace:^0.2.2",
    "@c3-oss/config-typescript": "workspace:^0.1.1",
    "@c3-oss/config-vitest": "workspace:^0.3.2",
    "@types/lodash": "^4.17.25",
    "@types/luxon": "^3.7.3"
  }
}
