{
  "name": "@c3-oss/fim",
  "description": "fim - Figlet IMproved, display large banners of text with customizations",
  "version": "0.1.0",
  "author": "Caian Ertl <caian@c3.do>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/sk.js.git"
  },
  "bin": {
    "@c3-oss/fim": "./dist/index.mjs",
    "fim": "./dist/index.mjs"
  },
  "scripts": {
    "build": "concurrently \"tsgo --noEmit\" \"tsdown src/index.ts --format cjs --format esm --dts --clean --deps.skip-node-modules-bundle\"",
    "build:tsgo": "tsgo --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome format --write .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf coverage dist node_modules .turbo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "bun run bump:dev && bun run bump:prod"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "workspace:^0.3.0",
    "@c3-oss/config-typescript": "workspace:^0.1.0",
    "@c3-oss/config-vitest": "workspace:^0.3.0",
    "@types/figlet": "^1.7.0",
    "@typescript/native-preview": "beta",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.2.1",
    "npm-check-updates": "^17.1.16",
    "tsdown": "^0.22.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "figlet": "^1.8.2",
    "ts-command-line-args": "^2.5.1"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "types": "./dist/index.d.mts"
}
