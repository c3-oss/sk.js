{
  "name": "@c3-oss/devbox-check-update",
  "description": "CLI to check and update Devbox packages in devbox.json files",
  "version": "0.2.0",
  "author": "Caian Ertl <caian@c3.do>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/sk.js.git"
  },
  "files": ["dist"],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "bin": {
    "devbox-check-update": "./dist/cli.mjs"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "concurrently \"tsgo --noEmit\" \"tsdown --config tsdown.config.ts --deps.skip-node-modules-bundle\"",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf coverage dist node_modules .turbo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "bun run bump:dev && bun run bump:prod"
  },
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "workspace:^",
    "@c3-oss/config-typescript": "workspace:^",
    "@c3-oss/config-vitest": "workspace:^",
    "@types/node": "^24.9.1",
    "@typescript/native-preview": "beta",
    "concurrently": "^9.2.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "bun": ">=1.3.13"
  }
}
