{
  "name": "@c3-oss/ecsenv",
  "description": "Fetch ECS Environments - Interactive TUI for injecting AWS ECS secrets and environment variables",
  "version": "0.1.1",
  "author": "Caian Ertl <caian@c3.do>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/sk.js.git"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "ecsenv": "./dist/index.mjs"
  },
  "scripts": {
    "start": "bun --preload dotenv-expand/config src/index.ts",
    "build": "concurrently \"tsgo --noEmit\" \"tsdown src/index.ts --format cjs --format esm --dts --clean --deps.skip-node-modules-bundle\"",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf coverage dist node_modules .turbo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "bun run bump:dev && bun run bump:prod"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1045.0",
    "@aws-sdk/client-secrets-manager": "^3.1045.0",
    "@c3-oss/aws-wrapper-ecs": "workspace:^",
    "@c3-oss/logger": "workspace:^",
    "@c3-oss/typeguard": "workspace:^",
    "fp-ts": "^2.16.11",
    "fs-extra": "^11.3.1",
    "ink": "^6.3.1",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@c3-oss/config-biome": "workspace:^",
    "@c3-oss/config-tsdown": "workspace:^",
    "@c3-oss/config-typescript": "workspace:^",
    "@c3-oss/config-vitest": "workspace:^",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^19.1.13",
    "@typescript/native-preview": "beta",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.1",
    "dotenv-expand": "^12.0.2",
    "npm-check-updates": "^18.0.2",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "types": "./dist/index.d.mts"
}
