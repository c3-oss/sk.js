{
  "name": "@c3-oss/foreach-agent",
  "description": "Terminal UI to run prompt templates across multiple AI coding agents",
  "version": "0.1.1",
  "author": "Caian Ertl <caian@c3.do>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/sk.js.git"
  },
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "bin": {
    "foreach-agent": "./dist/cli.mjs"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "concurrently \"tsgo --noEmit\" \"tsdown src/index.ts src/cli.ts --format cjs --format esm --dts --clean --deps.skip-node-modules-bundle\"",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "clean": "rm -rf coverage dist node_modules .turbo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "filtrex": "^3.1.0",
    "ink": "^6.3.1",
    "liquidjs": "^10.25.7",
    "react": "^19.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "workspace:^",
    "@c3-oss/config-typescript": "workspace:^",
    "@c3-oss/config-vitest": "workspace:^",
    "@types/node": "^24.9.1",
    "@types/react": "^19.1.13",
    "@typescript/native-preview": "beta",
    "concurrently": "^9.2.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "types": "./dist/index.d.mts"
}
